{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Betaflight Log Analyzer",
  "version": "1.7.0",
  "identifier": "de.gerd.bfloganalyzer",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "title": "Betaflight Log Analyzer",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 600,
        "backgroundColor": "#0a0f1e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}